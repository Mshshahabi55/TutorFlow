# Copy this file to `.env` (already gitignored — never commit the real file) and fill in real,
# locally-generated values. Used only by docker-compose.yml to bootstrap the local development
# PostgreSQL container — never read by the application itself (the app reads connection strings
# from .NET user-secrets / environment variables, see docs/DEVELOPMENT_DATABASE.md).
#
# Generate random values, e.g.: openssl rand -base64 24

# Bootstrap admin role docker-entrypoint-initdb.d uses once, to create the real app role below.
# Not used by the application at any point.
TUTORFLOW_DB_ADMIN_USER=tutorflow_admin
TUTORFLOW_DB_ADMIN_PASSWORD=change-me-generate-a-random-value

# The actual role every module's connection string authenticates as. Not a superuser; owns only
# the tutorflow_* databases created for it.
TUTORFLOW_DB_APP_USER=tutorflow_app
TUTORFLOW_DB_APP_PASSWORD=change-me-generate-a-different-random-value

# Host port the container publishes — change if 5432 is already taken locally.
TUTORFLOW_DB_PORT=5432

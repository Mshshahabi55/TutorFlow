{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TutorFlow": "Host=localhost;Database=tutorflow;Username=REPLACE_ME;Password=REPLACE_ME"
  },
  "OpenApi": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrate": false
  },
  "Meeting": {
    "DefaultProvider": "GoogleMeet",
    "Google": { "ClientId": "", "ClientSecret": "", "RefreshToken": "" },
    "Microsoft": { "TenantId": "", "ClientId": "", "ClientSecret": "", "OrganizerUserId": "" },
    "Zoom": { "AccountId": "", "ClientId": "", "ClientSecret": "" }
  },
  "RateLimiting": {
    "General": { "PermitLimit": 100, "WindowSeconds": 10 },
    "Auth": { "PermitLimit": 5, "WindowSeconds": 60 }
  }
}

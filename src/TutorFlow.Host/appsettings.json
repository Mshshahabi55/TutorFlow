{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "MessagingCreateConversation": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "MessagingSendMessage": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Issuer": "TutorFlow",
    "Audience": "TutorFlow",
    "ExpirationMinutes": 60
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "ClientId": "",
      "ClientSecret": ""
    }
  }
}
